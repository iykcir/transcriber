{
  "name": "transcriber",
  "version": "1.5.0",
  "description": "A macOS desktop app for transcribing audio files using OpenAI Whisper",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:whisper": "cd node_modules/nodejs-whisper/cpp/whisper.cpp && /opt/homebrew/bin/cmake -B build && /opt/homebrew/bin/cmake --build build --config Release",
    "build": "npm run build:whisper && electron-builder",
    "pack": "npm run build:whisper && electron-builder --dir"
  },
  "build": {
    "appId": "com.transcriber.app",
    "productName": "Transcriber",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Transcriber",
      "icon": "assets/icon.icns"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "nativeRebuilder": "sequential"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@vitalets/google-translate-api": "^9.2.1",
    "docx": "^9.7.1",
    "nodejs-whisper": "^0.3.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^1.4.0",
    "playwright-core": "^1.60.0"
  }
}
